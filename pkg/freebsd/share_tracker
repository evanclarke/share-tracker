#!/bin/sh
#
# PROVIDE: share_tracker
# REQUIRE: NETWORKING DAEMON
# KEYWORD: shutdown
#
# Add these lines to /etc/rc.conf.local or /etc/rc.conf to enable share-tracker:
#
# share_tracker_enable (bool):  Set to "YES" to enable. Default "NO".
# share_tracker_config (path):  Config file. Default "/usr/local/etc/share-tracker.toml".
# share_tracker_user (user):    User to run as. Default "share_tracker".

. /etc/rc.subr

name=share_tracker
rcvar=share_tracker_enable

load_rc_config $name

: ${share_tracker_enable:="NO"}
: ${share_tracker_config:="/usr/local/etc/share-tracker.toml"}
: ${share_tracker_user:="share_tracker"}

pidfile="/var/run/${name}/${name}.pid"
command="/usr/sbin/daemon"
# daemon(8) supervises the server: -r restarts it if it exits, -P writes the
# supervisor pidfile, and -S sends the server's stdout/stderr (tracing logs)
# to syslog under -T's tag. daemon(8) switches to the -u user *before*
# opening the -P pidfile (FreeBSD 14+), so the pidfile must live in a
# directory the service user can write; /var/run itself is root-only and
# cleared at boot, so the precmd (re)creates the subdirectory every start.
# The pidfile holds the supervisor's pid, so procname stays at its rc.subr
# default ($command, i.e. daemon): status/stop must match the supervisor —
# naming the server binary instead made check_pidfile reject the pid and
# status/stop report "not running" while the service kept running.
command_args="-S -T share-tracker -P ${pidfile} -r -u ${share_tracker_user} /usr/local/bin/share-tracker --config ${share_tracker_config}"
start_precmd="share_tracker_precmd"

share_tracker_precmd()
{
	install -d -o "${share_tracker_user}" "/var/run/${name}"
}

run_rc_command "$1"
