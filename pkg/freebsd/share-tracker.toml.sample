# share-tracker configuration.
#
# The FreeBSD package installs this as /usr/local/etc/share-tracker.toml on
# first install (upgrades preserve your edits). The server loads that path
# automatically; --config PATH points it elsewhere, and CLI flags override
# individual values. A setting left out falls back to the built-in default.
# Unknown keys are an error: the server refuses to start rather than silently
# ignore a typo.

# SQLite database file. The package creates /var/db/share-tracker owned by the
# share_tracker service user.
db = "/var/db/share-tracker/share-tracker.db"

# Directory the weekly backup job writes its verified backups to. Put this on
# a different volume than `db` if you can, so one disk failure can't take the
# database and its backups together.
backup_dir = "/var/db/share-tracker/backups"

# Command to run after each fresh, verified backup — e.g. to copy it
# off-machine. {BACKUP_FILE} is replaced with the backup's absolute path; runs
# via `sh -c`, so ordinary shell syntax works. Commented out by default: there
# is no universal safe destination, so pick a command for your own setup (scp,
# rsync, rclone, ...) before enabling it. A failing command fails the backup
# job (visible at GET /jobs) but never blocks the backup itself or its local
# pruning.
# backup_command = "scp {BACKUP_FILE} user@host:/backups/"

# Bind address. The server has no authentication: keep 127.0.0.1 (localhost
# only) unless the network is trusted — "0.0.0.0" exposes it.
host = "127.0.0.1"

# HTTP port.
port = 3000

# URL path prefix to mount the whole application under, for serving it from a
# sub-path behind a reverse proxy — e.g. "/share_tracker" puts the UI and the
# API at https://host/share_tracker/... . Every route moves under the prefix
# and the UI emits its URLs with it, so the proxy passes the path through
# unchanged (nginx: `location /share_tracker/ { proxy_pass http://127.0.0.1:3000; }`
# — no trailing slash on proxy_pass, or it would strip the prefix). Commented
# out by default: the server is mounted at the root unless you are proxying it.
# See the README's "Behind a reverse proxy" section for the full example.
# base_path = "/share_tracker"

# Cron schedule for the recurring maintenance jobs (backups, price and FX
# imports). The package installs the default schedule at this path; edit it to
# change run times.
schedule = "/usr/local/etc/share-tracker.cron"
