# FreeBSD package manifest (UCL). __VERSION__ is substituted with Cargo.toml's
# version by build-pkg.sh — the pkg version, the binary's --version, and the
# release tag all come from that single source.
name: "share-tracker"
version: "__VERSION__"
origin: "local/share-tracker"
comment: "Australian share portfolio tracker"
www: "https://github.com/evanclarke/share-tracker"
maintainer: "evan@evanclarke.com"
prefix: "/usr/local"
categories: ["finance"]
licenses: ["MIT"]
# curl: pkg/freebsd/update.sh needs it to POST the pre-upgrade backup trigger
# (fetch(1), FreeBSD's base HTTP client, cannot POST).
deps: {
  curl: { origin: "ftp/curl", version: "8.0.0" }
}
desc: <<EOD
Records facts about investing activity (trades, income, corporate actions,
AMMA and ESS statements) in SQLite and materialises portfolio, CGT and
income reports with the Australian tax view. Serves a web UI and JSON API
on localhost.
EOD
scripts: {
  # Create the non-login service user and its data directory. The user, the
  # database, and the backups deliberately survive pkg delete — removing the
  # package must never remove financial records.
  #
  # The sample→live config copy re-implements the ports `@sample` plist
  # keyword (keyword definitions ship with the ports tree, which the release
  # VM doesn't have, and `pkg create` fails on unknown keywords): first
  # install copies each .sample into place; deinstall (and so the deinstall
  # half of an upgrade) removes the live copy only while it still matches its
  # sample, so an edited config survives upgrades and pkg delete.
  post-install: <<EOD
if ! pw usershow share_tracker >/dev/null 2>&1; then
  pw useradd share_tracker -c "share-tracker daemon" -d /var/db/share-tracker -s /usr/sbin/nologin -h -
fi
mkdir -p /var/db/share-tracker/backups
chown -R share_tracker:share_tracker /var/db/share-tracker
# 0700, not the mkdir default 0755: the database and the backups beside it
# hold every record, and the directory mode is what makes them unreachable
# whatever mode each file was created with. 0700 also tightens the directory
# on an upgrade (a umask in the rc script would affect only files the running
# server creates, and would leave an already-0755 directory traversable).
chmod 700 /var/db/share-tracker
for f in share-tracker.toml share-tracker.cron newsyslog.conf.d/share-tracker.conf; do
  if [ ! -f "/usr/local/etc/$f" ]; then
    cp -p "/usr/local/etc/$f.sample" "/usr/local/etc/$f"
  fi
done
# The copy above runs only on first install, so an upgrade must tighten a live
# config the earlier package installed 0644 — it holds [auth].password_hash
# (the session-signing key's input) and [auth].api_token. The server runs as
# the service user (rc.subr su), so the 0600 file has to be owned by it: the
# cp -p above leaves it root-owned and 0600 root-owned is unreadable by the
# server. update.sh reads it as root, which still can.
if [ -f /usr/local/etc/share-tracker.toml ]; then
  chown share_tracker:share_tracker /usr/local/etc/share-tracker.toml
  chmod 600 /usr/local/etc/share-tracker.toml
fi
EOD
  pre-deinstall: <<EOD
for f in share-tracker.toml share-tracker.cron newsyslog.conf.d/share-tracker.conf; do
  if cmp -s "/usr/local/etc/$f.sample" "/usr/local/etc/$f"; then
    rm "/usr/local/etc/$f"
  fi
done
EOD
}
