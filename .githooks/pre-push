#!/bin/sh
# Pre-push gate: keep clippy clean before pushing. CI (.github/workflows/ci.yml)
# runs clippy and the full test suite; this hook is the fast local backstop for
# the lint half, so a regression is caught in seconds rather than in CI.
#
# Enabled per-clone via a tracked hooks dir:
#   git config core.hooksPath .githooks
#
# Bypass for a one-off push (e.g. a docs-only branch): git push --no-verify
set -e

echo "pre-push: cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings

echo "pre-push: ok"
