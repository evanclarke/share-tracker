#!/bin/sh
# Pre-push gate: run the exact CI checks locally so nothing dirty reaches CI.
# Mirrors .github/workflows/ci.yml (clippy as a hard error, then the full suite).
#
# Enabled per-clone via a tracked hooks dir:
#   git config core.hooksPath .githooks
#
# Bypass for a one-off push (e.g. a docs-only branch): git push --no-verify
set -e

echo "pre-push: cargo clippy --all-targets -- -D warnings"
cargo clippy --all-targets -- -D warnings

echo "pre-push: cargo test"
cargo test

echo "pre-push: ok"
